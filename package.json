{
  "name": "cafe-pomodoro",
  "displayName": "Cafe Pomodoro",
  "publisher": "rainmeowmeow",
  "description": "A cozy cafe-themed Pomodoro timer for VS Code.",
  "version": "0.0.3",
  "icon": "images/Cafe-Pomodoro.png",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cafe-pomodoro.startTimer",
        "title": "Cafe Pomodoro: Start Timer"
      },
      {
        "command": "cafe-pomodoro.pauseTimer",
        "title": "Cafe Pomodoro: Pause / Resume Timer"
      },
      {
        "command": "cafe-pomodoro.stopTimer",
        "title": "Cafe Pomodoro: Stop Session"
      },
      {
        "command": "cafe-pomodoro.viewStats",
        "title": "Cafe Pomodoro: View Stats"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "@types/vscode": "^1.95.0",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.61.1"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
